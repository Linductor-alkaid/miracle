<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P0：网络（模型调用 P3 起）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- P1：媒体投影前台服务与常驻通知（同意体系，架构设计 §7）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- P3：悬浮球（SYSTEM_ALERT_WINDOW 特殊授权，设置页引导）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miracle">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Miracle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".host.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- P2：输入链路（dispatchGesture/文本注入/全局导航），系统设置中由用户显式启用。 -->
        <service
            android:name=".host.MiracleAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
